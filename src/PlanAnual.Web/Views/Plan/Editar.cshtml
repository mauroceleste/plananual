@model EditarVm
@{
    var p = Model.P;
    var paso = Model.Actual;
    var ro = Model.SoloLectura;
    ViewData["Title"] = p.NombreArea; ViewData["Ancha"] = true;
    var anioFirme = p.Ciclo!.Anio;
    var nombreArea = p.NombreArea == p.NombreBloque ? p.NombreArea : p.NombreArea + " - " + p.NombreBloque;
    var sesion = User.ToSesion();
    var asiste = sesion.EsAsistencia(p.Cuit);
}
<div class="container-xl is-wide py-4">
    <div class="page-head">
        <div>
            <span class="page-head__eyebrow">@p.Ciclo.Nombre · @p.RazonSocial</span>
            <h1>@nombreArea</h1>
            <p>
                <span class="chip chip--tag">@Validador.NombreActividad(Model.TipoActual)</span>
                @if (p.Estado == EstadoPresentacion.Borrador) { <span class="chip chip--warn">Borrador @(p.Version > 1 ? $"· rectificatoria v{p.Version}" : "")</span> }
                else { <span class="chip chip--ok">Enviada v@(p.Version)</span> }
            </p>
        </div>
        <div class="d-flex flex-column align-items-end gap-2">
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-route-cuit="@(asiste ? p.Cuit : null)" data-flush>@Url.Icono("arrow-left") @(asiste ? "Áreas de la empresa" : "Mis áreas")</a>
            @if (!ro) { <span class="guardado" id="estado-guardado" role="status" aria-live="polite">@Url.Icono("check")<span>Los cambios se guardan solos</span></span> }
        </div>
    </div>

    @if (asiste && !ro) { <div class="alert alert-info">@Url.Icono("info")<div><strong>Estás asistiendo a @p.RazonSocial</strong> · Lo que cargues y envíes queda registrado a tu nombre.</div></div> }
    @if (p.AsistidaPor is not null) { <div class="alert alert-secondary">@Url.Icono("user")<div>Esta planilla se cargó con asistencia de Administración (@p.AsistidaPor).</div></div> }
    @if (ro) { <div class="alert alert-info">@Url.Icono("lock")<div>Esta versión ya fue enviada y no se puede modificar. <a asp-action="Comprobante" asp-route-id="@p.Id">Ver el comprobante</a>.</div></div> }

    @* Un área puede tener plan Convencional y No Convencional: se carga de a uno; el que no tenga se declara «sin actividad» (0). *@
    <ul class="nav nav-pills mb-3" aria-label="Plan de actividad">
        @foreach (var t in Presentacion.Actividades)
        {
            var cargado = Model.Cargados.Contains(t);
            <li class="nav-item">
                <a class="nav-link @(t == Model.TipoActual ? "active" : "")" asp-action="Editar" asp-route-id="@p.Id" asp-route-paso="@(paso.Tipo == TipoPaso.Grilla ? paso.Indice : 0)" asp-route-plan="@((int)t)" data-flush aria-current="@(t == Model.TipoActual ? "page" : null)">
                    @Validador.NombreActividad(t)
                    <span class="badge rounded-pill @(cargado ? "text-bg-success" : "text-bg-secondary") ms-1">@(cargado ? "cargado" : "sin datos")</span>
                </a>
            </li>
        }
    </ul>
    @if (paso.Tipo == TipoPaso.Grilla && !ro)
    {
        <form asp-action="SinActividad" asp-route-id="@p.Id" method="post" data-una-vez
              data-confirmar="Se carga 0 en todo el @Validador.NombreActividad(Model.TipoActual) (reemplaza lo que hubiera). ¿Continuar?" class="mb-3">
            <input type="hidden" name="plan" value="@((int)Model.TipoActual)" /><input type="hidden" name="paso" value="@paso.Indice" />
            <button class="btn btn-outline-secondary btn-sm">Esta área no tiene actividad: @(Model.TipoActual == TipoPlan.Cench ? "No Convencional" : "Convencional") (cargar todo en 0)</button>
        </form>
    }

    <nav class="stepper" aria-label="Pasos del formulario">
        <ol>
            @foreach (var s in Model.Pasos)
            {
                <li class="@(s.Indice == paso.Indice ? "is-current" : "")">
                    <a asp-action="Editar" asp-route-id="@p.Id" asp-route-paso="@s.Indice" asp-route-plan="@((int)Model.TipoActual)" data-flush aria-current="@(s.Indice == paso.Indice ? "step" : null)">
                        <span class="stepper__n">@(s.Indice + 1)</span><span class="stepper__t">@s.Titulo</span></a>
                </li>
            }
        </ol>
    </nav>

    @if (paso.Tipo == TipoPaso.Grilla)
    {
        <div class="panel">
            <div class="panel__head"><h2 class="panel__title">@Url.Icono("layers") @paso.Titulo</h2></div>

            @if (paso.Indice == 0 && !ro)
            {
                <form asp-action="Rango" asp-route-id="@p.Id" method="post" class="rango" data-una-vez>
                    <input type="hidden" name="paso" value="0" />
                    <input type="hidden" name="desde" value="@anioFirme" />
                    <label>Años de la planilla: desde <strong>@anioFirme</strong> (mes por mes) hasta <input class="form-control form-control-sm" type="number" name="hasta" value="@p.AnioHasta" min="@anioFirme" max="@(anioFirme + 60)" /></label>
                    <button class="btn btn-outline-secondary btn-sm">Aplicar</button>
                    <span class="form-text">Cargá hasta el vencimiento de la concesión. Si achicás el rango se descartan los años que queden afuera.</span>
                </form>
            }

            <p class="form-text mb-2">
                Usá coma para los decimales (ej. 12,5). Podés pegar un bloque copiado desde Excel: se completa a partir de la celda donde estés parado.
                Las columnas grises se calculan solas.
            </p>

            <details class="consideraciones" open="@(paso.Indice == 0)">
                <summary>@Url.Icono("info") Consideraciones a tener en cuenta</summary>
                <ul>
                    <li>Todos los montos están en <strong>millones de dólares (MMUSD)</strong>; los volúmenes, en las unidades que indica cada columna. No mezcles unidades: por ejemplo, 1,5 MMUSD son USD 1.500.000.</li>
                    <li>Cargá todas las celdas de cada año. Si no hay actividad o valor, ingresá <strong>0</strong> en lugar de dejarla vacía.</li>
                    <li>El año <strong>@anioFirme</strong> (compromiso firme de cumplimiento) se carga <strong>mes por mes</strong>; los años siguientes, uno por fila. La fila "@anioFirme total" la calcula el sistema: suma los meses (o promedia, o toma el máximo o el último mes, según el campo).</li>
                    <li>Los valores <strong>diarios</strong> (bbl/d, MMm3/d) son promedios del año; los <strong>acumulados</strong> (%) crecen año a año y no se suman.</li>
                </ul>
                <table class="consideraciones__unidades">
                    <thead><tr><th>Unidad</th><th>Significa</th><th>Columnas de este paso</th></tr></thead>
                    <tbody>
                        @foreach (var g in paso.Campos.GroupBy(x => x.Unidad).OrderBy(x => x.Key))
                        {
                            <tr><td><strong>@g.Key</strong></td><td>@CatalogoCampos.DescripcionUnidad(g.Key)</td><td>@string.Join(", ", g.Take(4).Select(x => x.Nombre))@(g.Count() > 4 ? $" y {g.Count() - 4} más" : "")</td></tr>
                        }
                    </tbody>
                </table>
            </details>

            <div class="grilla-wrap" tabindex="0" aria-label="Planilla de @paso.Titulo">
                <table class="grilla" data-guardar="@Url.Action("Guardar", "Plan", new { id = p.Id, plan = (int)Model.TipoActual })" data-ro="@(ro ? "1" : "0")">
                    <thead>
                        <tr>
                            <th class="grilla__anio" scope="col">Año</th>
                            @foreach (var c in paso.Campos)
                            {
                                <th scope="col" class="@(c.EsCalculado ? "is-calc" : "")" title="@c.Ayuda">
                                    <span class="grilla__nombre">@c.Nombre</span><span class="grilla__unidad">@c.Unidad@(c.EsCalculado ? "" : " · " + ReglasDeDatos.Descripcion(c))</span>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.Filas)
                        {
                            var anio = f.Anio;
                            var etiqueta = f.Mes > 0 ? $"{Validador.Meses[f.Mes - 1]} {anio}" : anio.ToString();
                            <tr data-anio="@anio" data-mes="@f.Mes" data-clave="@f.Clave" class="@(anio == anioFirme ? "es-firme" : "") @(f.EsSubtotal ? "es-subtotal" : "")">
                                <th scope="row" class="grilla__anio">
                                    @if (f.EsSubtotal) { <span>@anio total</span><span class="grilla__firme" title="Compromiso firme de cumplimiento">firme</span> }
                                    else if (f.Mes > 0) { <span>@anio</span> <small class="grilla__mes">@Validador.Meses[f.Mes - 1][..3]</small> }
                                    else { @anio }
                                </th>
                                @foreach (var c in paso.Campos)
                                {
                                    var v = Model.Valor(f, c);
                                    if (c.EsCalculado || f.EsSubtotal)
                                    {
                                        <td class="is-calc"><output data-calc="@c.Codigo">@(v is null ? "" : Formato.Num(v, "N2"))</output></td>
                                    }
                                    else
                                    {
                                        <td><input type="text" inputmode="@(c.DecimalesMax == 0 ? "numeric" : "decimal")" autocomplete="off" spellcheck="false" maxlength="22"
                                                   data-campo="@c.Codigo" data-dec="@c.DecimalesMax" data-max="@(c.Maximo?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                                   aria-label="@c.Nombre, @etiqueta" value="@Formato.Num(v)" readonly="@ro" /></td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th class="grilla__anio" scope="row">Total</th>
                            @foreach (var c in paso.Campos)
                            {
                                if (EditarVm.Aditivo(c)) { <td class="is-calc"><output data-total="@c.Codigo" data-dec="@c.DecimalesMax"></output></td> } else { <td class="is-calc">—</td> }
                            }
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
    else if (paso.Tipo == TipoPaso.Anexos)
    {
        <div class="panel">
            <div class="panel__head"><h2 class="panel__title">@Url.Icono("paperclip") Documentación de respaldo</h2></div>
            <p class="form-text">Son los puntos que pide la nota. Los marcados como <span class="chip chip--warn">Requerido</span> son obligatorios: sin ellos no se puede hacer la presentación final. Formatos: PDF, Excel, Word, PowerPoint, imágenes, ZIP, KML.</p>
            <ul class="anexos">
                @foreach (var t in AnexosRequeridos.Todos)
                {
                    var subidos = p.Anexos.Where(a => a.Tipo == t.Codigo).ToList();
                    <li>
                        <div class="anexos__titulo">
                            <strong>@t.Titulo(anioFirme)</strong>
                            @if (t.Obligatorio) { <span class="chip @(subidos.Any() ? "chip--ok" : "chip--warn")">@(subidos.Any() ? "Presentado" : "Requerido")</span> }
                            else if (subidos.Any()) { <span class="chip chip--ok">Presentado</span> }
                        </div>
                        @if (PlanillasModelo.DeAnexo(t.Codigo) is { } modelo)
                        {
                            <div class="form-text">@Url.Icono("download") <a asp-action="PlanillaModelo" asp-route-id="@p.Id" asp-route-tipo="@modelo">Descargar la planilla modelo</a> (Excel) para completarla y adjuntarla acá.</div>
                        }
                        @foreach (var a in subidos)
                        {
                            <div class="anexos__archivo">
                                <a asp-action="AnexoDescargar" asp-route-id="@p.Id" asp-route-anexoId="@a.Id">@Url.Icono("file") @a.NombreArchivo</a>
                                <small class="text-muted">@(a.Tamano < 1048576 ? (a.Tamano / 1024 + " KB") : ((a.Tamano / 1048576m).ToString("0.0", Formato.AR) + " MB"))</small>
                                @if (!ro)
                                {
                                    <form asp-action="AnexoQuitar" asp-route-id="@p.Id" method="post" data-una-vez data-confirmar="¿Quitar este archivo?" class="d-inline">
                                        <input type="hidden" name="anexoId" value="@a.Id" /><input type="hidden" name="paso" value="@paso.Indice" />
                                        <button class="btn btn-ghost-danger btn-sm" title="Quitar">@Url.Icono("trash")</button></form>
                                }
                            </div>
                        }
                        @if (!ro)
                        {
                            <form asp-action="AnexoSubir" asp-route-id="@p.Id" method="post" enctype="multipart/form-data" data-una-vez class="anexos__subir">
                                <input type="hidden" name="tipo" value="@t.Codigo" /><input type="hidden" name="paso" value="@paso.Indice" />
                                <input class="form-control form-control-sm" type="file" name="archivo" required aria-label="Archivo para @t.Nombre" />
                                <button class="btn btn-outline-secondary btn-sm">@Url.Icono("plus") Adjuntar</button>
                            </form>
                        }
                    </li>
                }
            </ul>
        </div>
    }
    else if (paso.Tipo == TipoPaso.Texto)
    {
        var textos = new (string Nombre, string Titulo, string? Valor, string Ayuda)[]
        {
            ("conflictos", Validador.TextosBloque4[0].Titulo, p.ConflictosSuperficiarios, "Conflictos vigentes o previstos con superficiarios que puedan afectar la actividad."),
            ("contratosFirmes", Validador.TextosBloque4[1].Titulo, p.EquiposContratosFirmes, $"Equipos de perforación, terminación, workover y otros servicios con contrato firme para {anioFirme}."),
            ("plazos", Validador.TextosBloque4[2].Titulo, p.EquiposPlazos, "Plazos de los contratos y perspectivas de disponibilidad."),
            ("costos", Validador.TextosBloque4[3].Titulo, p.EquiposCostos, "Costos de los contratos y perspectivas de variación."),
        };
        <div class="panel">
            <div class="panel__head"><h2 class="panel__title">@Url.Icono("alert") Restricciones a la actividad</h2></div>
            <p class="form-text">Bloque 4 de la nota. Completá los cuatro puntos; si en alguno no hay nada para informar, escribí <strong>Ninguno</strong>. Se guarda solo al salir de cada cuadro.
                Si preferís ordenar la información antes, <a asp-action="PlanillaModelo" asp-route-id="@p.Id" asp-route-tipo="@PlanillasModelo.Bloque4">descargá la planilla modelo</a> (conflictos y equipos): sirve de guía para redactar los textos, y se puede adjuntar en «Otros» del paso de documentación.</p>
            <form asp-action="GuardarTexto" asp-route-id="@p.Id" method="post" id="form-texto" data-ro="@(ro ? "1" : "0")" data-ajax="@Url.Action("GuardarTexto", "Plan", new { id = p.Id })">
                <input type="hidden" name="paso" value="@paso.Indice" />
                @foreach (var t in textos)
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="t-@t.Nombre">@t.Titulo</label>
                        <textarea id="t-@t.Nombre" name="@t.Nombre" class="form-control" rows="4" maxlength="4000" readonly="@ro">@t.Valor</textarea>
                        <div class="form-text">@t.Ayuda</div>
                    </div>
                }
                @if (!ro)
                {
                    <span class="guardado" id="estado-texto" role="status" aria-live="polite">@Url.Icono("check")<span>Los cambios se guardan solos</span></span>
                    <button class="btn btn-outline-secondary btn-sm ms-2">Guardar</button>
                }
            </form>
        </div>
    }
    else
    {
        var errores = Model.Observaciones.Where(o => o.EsError).ToList();
        var requisitos = Model.Observaciones.Where(o => !o.EsError && o.EsRequisito).ToList();
        var avisos = Model.Observaciones.Where(o => !o.EsError && !o.EsRequisito).ToList();
        // Calc trae una fila por mes y una anual por año (clave año*100): para los totales se usan solo las anuales, que ya suman los meses.
        var anuales = Model.Calc.Where(kv => kv.Key % 100 == 0).ToList();
        var firme = Model.Calc.GetValueOrDefault(Calculadora.Clave(anioFirme, 0));
        var totalInv = anuales.Sum(kv => kv.Value.GetValueOrDefault("inv_total"));
        <div class="stat-row">
            <div class="stat" style="--acento: var(--nqn-turquesa)"><div class="stat__label">Inversión @anioFirme (firme)</div><div class="stat__value">@Formato.Num2(firme?.GetValueOrDefault("inv_total"))</div><div class="stat__foot">MMUSD</div></div>
            <div class="stat" style="--acento: var(--nqn-amarillo)"><div class="stat__label">Inversión @p.AnioDesde–@p.AnioHasta</div><div class="stat__value">@Formato.Num2(totalInv)</div><div class="stat__foot">MMUSD</div></div>
            <div class="stat" style="--acento: var(--nqn-verde)"><div class="stat__label">Pozos a perforar @anioFirme</div><div class="stat__value">@Formato.Num2(firme?.GetValueOrDefault("pozos_perforados"))</div><div class="stat__foot">pozos</div></div>
            <div class="stat" style="--acento: var(--azul-500)"><div class="stat__label">Anexos adjuntos</div><div class="stat__value">@p.Anexos.Count</div><div class="stat__foot">@AnexosRequeridos.Todos.Count(a => a.Obligatorio) requeridos</div></div>
        </div>

        <div class="panel">
            <div class="panel__head"><h2 class="panel__title">@Url.Icono("check") Revisión antes de enviar</h2></div>
            @if (!errores.Any() && !requisitos.Any()) { <div class="alert alert-success">@Url.Icono("check")<div><strong>Esta área cumple con todos los requisitos de la nota.</strong> Cuando todas tus áreas estén completas, se envían juntas con la presentación final.</div></div> }
            @if (errores.Any())
            {
                <div class="alert alert-danger">@Url.Icono("alert")<div><strong>Hay datos para corregir:</strong>
                    <ul class="mb-0">@foreach (var o in errores) { <li>@(o.Anio is not null ? o.Anio + ": " : "")@o.Mensaje</li> }</ul></div></div>
            }
            @if (requisitos.Any())
            {
                <div class="alert alert-danger">@Url.Icono("alert")<div><strong>Falta cumplir con la nota (sin esto no se puede hacer la presentación final):</strong>
                    <ul class="mb-0">@foreach (var o in requisitos) { <li>@(o.Anio is not null ? o.Anio + ": " : "")@o.Mensaje</li> }</ul></div></div>
            }
            @if (avisos.Any())
            {
                <div class="alert alert-warning">@Url.Icono("info")<div><strong>Advertencias (no bloquean):</strong>
                    <ul class="mb-0">@foreach (var o in avisos) { <li>@(o.Anio is not null ? o.Anio + ": " : "")@o.Mensaje</li> }</ul></div></div>
            }
            <p><a class="btn btn-outline-secondary btn-sm" asp-action="Exportar" asp-route-id="@p.Id">@Url.Icono("download") Descargar lo cargado en Excel</a></p>
            @if (!ro)
            {
                <p class="form-text">Las áreas no se envían de a una: la <strong>presentación final</strong> se hace desde Mis áreas y solo se habilita cuando todas las áreas de la empresa cumplen con los requisitos de la nota. Al enviarla, cada área queda registrada con su comprobante y te llega un mail. El año @anioFirme se considera <strong>compromiso firme de cumplimiento</strong>. Si después necesitás corregir algo, vas a poder pedir autorización a la Subsecretaría para presentar una rectificatoria (nueva versión).</p>
                <a class="btn btn-primary btn-lg" asp-action="Index" asp-route-cuit="@(asiste ? p.Cuit : null)" data-flush>@Url.Icono("layers") Ir a Mis áreas</a>
            }
        </div>
    }

    <div class="action-bar">
        @if (paso.Indice > 0) { <a class="btn btn-outline-secondary" asp-action="Editar" asp-route-id="@p.Id" asp-route-paso="@(paso.Indice - 1)" asp-route-plan="@((int)Model.TipoActual)" data-flush>@Url.Icono("left") Anterior</a> } else { <span></span> }
        @if (paso.Indice < Model.Pasos.Count - 1) { <a class="btn btn-primary" asp-action="Editar" asp-route-id="@p.Id" asp-route-paso="@(paso.Indice + 1)" asp-route-plan="@((int)Model.TipoActual)" data-flush>Siguiente @Url.Icono("right")</a> }
    </div>
</div>

@section Scripts {
    <script src="~/js/plan-form.js" asp-append-version="true"></script>
    <script src="~/js/texto-form.js" asp-append-version="true"></script>
}
